/ {
    chosen {
        zephyr,code-partition = &slot0_partition;
    };

    /*
     * PM power states for nRF52840.
     * min-residency-us: minimum idle window before the PM policy commits to
     *   this state.  500 µs is well below the IMU interrupt period (~83 ms at
     *   12 Hz ODR) so virtually every idle window qualifies.
     * exit-latency-us: worst-case wakeup time before the CPU is active again.
     */
    power-states {
        suspend_to_idle: suspend-to-idle {
            compatible = "zephyr,power-state";
            power-state-name = "suspend-to-idle";
            min-residency-us = <500>;
            exit-latency-us = <100>;
        };
    };
};

/* Link the power state to the Cortex-M4 core so the PM policy can select it.
 * nRF52840 DTSI has no 'cpu0' label; reference by path instead. */
&{/cpus/cpu@0} {
    cpu-power-states = <&suspend_to_idle>;
};

/*
 * Disable the on-board QSPI NOR flash (MX25R6435F).
 * The board BSP enables it by default, but this app does not use it.
 * Without this, pm_resume_devices() is called from ISR context
 * (_isr_wrapper → pm_system_resume) and qspi_nor_pm_action(RESUME)
 * calls qspi_lock() → k_sem_take(K_FOREVER) → assertion in sem.c.
 */
&qspi {
    status = "disabled";
};

&i2c0 {
    lsm6dso0: lsm6dso@6a {
        compatible = "st,lsm6dso";
        reg = <0x6a>;
        irq-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
        int-pin = <2>;
    };
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 0xc000>;
        };
        slot0_partition: partition@c000 {
            label = "image-0";
            reg = <0x0000c000 0x76000>;
        };
        slot1_partition: partition@82000 {
            label = "image-1";
            reg = <0x00082000 0x76000>;
        };
        storage_partition: partition@f8000 {
            label = "storage";
            reg = <0x000f8000 0x00008000>;
        };
    };
};
